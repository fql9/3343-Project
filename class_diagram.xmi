<?xml version="1.0" encoding="UTF-8"?>
<XMI xmi.version="2.1" xmlns:UML="http://schema.omg.org/spec/UML/2.1">
  <XMI.header>
    <XMI.documentation>
      <XMI.exporter>SecondHandTrading Class Diagram Generator</XMI.exporter>
      <XMI.exporterVersion>1.0</XMI.exporterVersion>
    </XMI.documentation>
  </XMI.header>
  <XMI.content>
    <UML:Model xmi.id="model1" name="SecondHandTradingPlatform">
      
      <!-- Package: model -->
      <UML:Namespace.ownedElement>
        <UML:Package xmi.id="pkg_model" name="model">
          <UML:Namespace.ownedElement>
            
            <!-- Enum: UserRole -->
            <UML:Enumeration xmi.id="enum_UserRole" name="UserRole">
              <UML:Enumeration.literal>
                <UML:EnumerationLiteral xmi.id="lit_BUYER" name="BUYER"/>
                <UML:EnumerationLiteral xmi.id="lit_SELLER" name="SELLER"/>
                <UML:EnumerationLiteral xmi.id="lit_ADMIN" name="ADMIN"/>
              </UML:Enumeration.literal>
            </UML:Enumeration>
            
            <!-- Class: User -->
            <UML:Class xmi.id="cls_User" name="User">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_User_id" name="id" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_Long"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_username" name="username" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_passwordHash" name="passwordHash" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_email" name="email" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_role" name="role" visibility="private">
                  <UML:StructuralFeature.type><UML:Enumeration xmi.idref="enum_UserRole"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_active" name="active" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_boolean"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_avatarUrl" name="avatarUrl" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_bio" name="bio" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
                <UML:Attribute xmi.id="attr_User_createdTime" name="createdTime" visibility="private">
                  <UML:StructuralFeature.type><UML:DataType xmi.idref="dt_String"/></UML:StructuralFeature.type>
                </UML:Attribute>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Item -->
            <UML:Class xmi.id="cls_Item" name="Item">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Item_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_sellerId" name="sellerId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_title" name="title" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_description" name="description" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_price" name="price" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_category" name="category" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_imageUrl" name="imageUrl" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_active" name="active" visibility="private"/>
                <UML:Attribute xmi.id="attr_Item_createdTime" name="createdTime" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Order -->
            <UML:Class xmi.id="cls_Order" name="Order">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Order_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_orderNo" name="orderNo" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_buyerId" name="buyerId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_sellerId" name="sellerId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_itemId" name="itemId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_amount" name="amount" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_status" name="status" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_shippingAddress" name="shippingAddress" visibility="private"/>
                <UML:Attribute xmi.id="attr_Order_createdTime" name="createdTime" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Message -->
            <UML:Class xmi.id="cls_Message" name="Message">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Message_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Message_fromUserId" name="fromUserId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Message_toUserId" name="toUserId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Message_content" name="content" visibility="private"/>
                <UML:Attribute xmi.id="attr_Message_createdTime" name="createdTime" visibility="private"/>
                <UML:Attribute xmi.id="attr_Message_read" name="read" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Notification -->
            <UML:Class xmi.id="cls_Notification" name="Notification">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Notification_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Notification_userId" name="userId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Notification_title" name="title" visibility="private"/>
                <UML:Attribute xmi.id="attr_Notification_content" name="content" visibility="private"/>
                <UML:Attribute xmi.id="attr_Notification_isRead" name="isRead" visibility="private"/>
                <UML:Attribute xmi.id="attr_Notification_createdTime" name="createdTime" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Review -->
            <UML:Class xmi.id="cls_Review" name="Review">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Review_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_orderId" name="orderId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_reviewerId" name="reviewerId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_revieweeId" name="revieweeId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_itemId" name="itemId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_rating" name="rating" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_comment" name="comment" visibility="private"/>
                <UML:Attribute xmi.id="attr_Review_createdTime" name="createdTime" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
            <!-- Class: Favorite -->
            <UML:Class xmi.id="cls_Favorite" name="Favorite">
              <UML:Classifier.feature>
                <UML:Attribute xmi.id="attr_Favorite_id" name="id" visibility="private"/>
                <UML:Attribute xmi.id="attr_Favorite_userId" name="userId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Favorite_itemId" name="itemId" visibility="private"/>
                <UML:Attribute xmi.id="attr_Favorite_createdTime" name="createdTime" visibility="private"/>
              </UML:Classifier.feature>
            </UML:Class>
            
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: dao -->
        <UML:Package xmi.id="pkg_dao" name="dao">
          <UML:Namespace.ownedElement>
            <UML:Interface xmi.id="ifc_UserDao" name="UserDao"/>
            <UML:Interface xmi.id="ifc_ItemDao" name="ItemDao"/>
            <UML:Interface xmi.id="ifc_OrderDao" name="OrderDao"/>
            <UML:Interface xmi.id="ifc_MessageDao" name="MessageDao"/>
            <UML:Interface xmi.id="ifc_NotificationDao" name="NotificationDao"/>
            <UML:Interface xmi.id="ifc_ReviewDao" name="ReviewDao"/>
            <UML:Interface xmi.id="ifc_FavoriteDao" name="FavoriteDao"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: dao.impl -->
        <UML:Package xmi.id="pkg_dao_impl" name="dao.impl">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_UserDaoImpl" name="UserDaoImpl"/>
            <UML:Class xmi.id="cls_ItemDaoImpl" name="ItemDaoImpl"/>
            <UML:Class xmi.id="cls_OrderDaoImpl" name="OrderDaoImpl"/>
            <UML:Class xmi.id="cls_MessageDaoImpl" name="MessageDaoImpl"/>
            <UML:Class xmi.id="cls_NotificationDaoImpl" name="NotificationDaoImpl"/>
            <UML:Class xmi.id="cls_ReviewDaoImpl" name="ReviewDaoImpl"/>
            <UML:Class xmi.id="cls_FavoriteDaoImpl" name="FavoriteDaoImpl"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: service -->
        <UML:Package xmi.id="pkg_service" name="service">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_UserService" name="UserService"/>
            <UML:Class xmi.id="cls_ItemService" name="ItemService"/>
            <UML:Class xmi.id="cls_OrderService" name="OrderService"/>
            <UML:Class xmi.id="cls_MessageService" name="MessageService"/>
            <UML:Class xmi.id="cls_NotificationService" name="NotificationService"/>
            <UML:Class xmi.id="cls_ReviewService" name="ReviewService"/>
            <UML:Class xmi.id="cls_FavoriteService" name="FavoriteService"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: config -->
        <UML:Package xmi.id="pkg_config" name="config">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_DatabaseConfig" name="DatabaseConfig"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: util -->
        <UML:Package xmi.id="pkg_util" name="util">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_PasswordUtils" name="PasswordUtils"/>
            <UML:Class xmi.id="cls_ValidationUtils" name="ValidationUtils"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: view.util -->
        <UML:Package xmi.id="pkg_view_util" name="view.util">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_DialogUtils" name="DialogUtils"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Package: view.controller -->
        <UML:Package xmi.id="pkg_view_controller" name="view.controller">
          <UML:Namespace.ownedElement>
            <UML:Class xmi.id="cls_MainApp" name="MainApp"/>
            <UML:Class xmi.id="cls_LoginController" name="LoginController"/>
            <UML:Class xmi.id="cls_MainController" name="MainController"/>
            <UML:Class xmi.id="cls_BoardController" name="BoardController"/>
            <UML:Class xmi.id="cls_ItemDetailController" name="ItemDetailController"/>
            <UML:Class xmi.id="cls_CheckoutController" name="CheckoutController"/>
            <UML:Class xmi.id="cls_MyItemsController" name="MyItemsController"/>
            <UML:Class xmi.id="cls_OrderHistoryController" name="OrderHistoryController"/>
            <UML:Class xmi.id="cls_SalesHistoryController" name="SalesHistoryController"/>
            <UML:Class xmi.id="cls_FavoritesController" name="FavoritesController"/>
            <UML:Class xmi.id="cls_MessageController" name="MessageController"/>
            <UML:Class xmi.id="cls_NotificationController" name="NotificationController"/>
            <UML:Class xmi.id="cls_UserProfileController" name="UserProfileController"/>
            <UML:Class xmi.id="cls_UserManagementController" name="UserManagementController"/>
          </UML:Namespace.ownedElement>
        </UML:Package>
        
        <!-- Realizations (Interface Implementations) -->
        <UML:Abstraction xmi.id="real_UserDaoImpl" name="UserDaoImpl_implements_UserDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_UserDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_UserDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_ItemDaoImpl" name="ItemDaoImpl_implements_ItemDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_ItemDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_ItemDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_OrderDaoImpl" name="OrderDaoImpl_implements_OrderDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_OrderDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_OrderDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_MessageDaoImpl" name="MessageDaoImpl_implements_MessageDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_MessageDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_MessageDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_NotificationDaoImpl" name="NotificationDaoImpl_implements_NotificationDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_NotificationDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_NotificationDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_ReviewDaoImpl" name="ReviewDaoImpl_implements_ReviewDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_ReviewDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_ReviewDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        <UML:Abstraction xmi.id="real_FavoriteDaoImpl" name="FavoriteDaoImpl_implements_FavoriteDao">
          <UML:Dependency.client><UML:Class xmi.idref="cls_FavoriteDaoImpl"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_FavoriteDao"/></UML:Dependency.supplier>
        </UML:Abstraction>
        
        <!-- Dependencies -->
        <UML:Dependency xmi.id="dep_UserService_UserDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_UserService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_UserDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_ItemService_ItemDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_ItemService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_ItemDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_OrderService_OrderDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_OrderService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_OrderDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_MessageService_MessageDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_MessageService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_MessageDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_NotificationService_NotificationDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_NotificationService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_NotificationDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_ReviewService_ReviewDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_ReviewService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_ReviewDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        <UML:Dependency xmi.id="dep_FavoriteService_FavoriteDao" name="uses">
          <UML:Dependency.client><UML:Class xmi.idref="cls_FavoriteService"/></UML:Dependency.client>
          <UML:Dependency.supplier><UML:Interface xmi.idref="ifc_FavoriteDao"/></UML:Dependency.supplier>
        </UML:Dependency>
        
        <!-- Data Types -->
        <UML:DataType xmi.id="dt_Long" name="Long"/>
        <UML:DataType xmi.id="dt_String" name="String"/>
        <UML:DataType xmi.id="dt_boolean" name="boolean"/>
        <UML:DataType xmi.id="dt_double" name="double"/>
        <UML:DataType xmi.id="dt_int" name="int"/>
        
      </UML:Namespace.ownedElement>
    </UML:Model>
  </XMI.content>
</XMI>

