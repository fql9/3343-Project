@startuml Submit_Review_Sequence

title Submit Review Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":Buyer" as Buyer
participant ":OrderHistoryController" as OHC
participant ":ReviewService" as RS
participant ":ReviewDaoImpl" as RD
participant ":DialogUtils" as DU
database ":Database" as DB

autonumber

== Precondition: Order status is COMPLETED ==

Buyer -> OHC: showOrderHistoryView()
activate OHC

OHC -> OHC: loadOrders()
OHC -> RS: hasReviewed(orderId: Long): boolean
activate RS
RS -> RD: findByOrderId(orderId: Long): Review
activate RD
RD -> DB: <<SQL>> SELECT * FROM reviews \nWHERE order_id = ?
activate DB
DB --> RD: ResultSet
deactivate DB
RD --> RS: review: Review
deactivate RD
RS --> OHC: hasReviewed: boolean
deactivate RS

alt hasReviewed == false
    OHC -> OHC: show "Review" button
else hasReviewed == true
    OHC -> OHC: show "Reviewed" label
end

OHC --> Buyer: <<display>> Order List with Review Button
deactivate OHC

Buyer -> OHC: showReviewDialog(order: Order)
activate OHC

OHC -> OHC: dialog = new Dialog<ButtonType>()
OHC -> OHC: dialog.setTitle("Write a Review")

note right of OHC: Create review form
OHC -> OHC: ratingBox = ComboBox(5, 4, 3, 2, 1)
OHC -> OHC: commentArea = TextArea()

OHC --> Buyer: <<display>> Review Dialog

Buyer -> OHC: select rating and enter comment
Buyer -> OHC: click Submit button

OHC -> OHC: rating = ratingBox.getValue()
OHC -> OHC: comment = commentArea.getText()

OHC -> RS: addReview(orderId: Long, reviewerId: Long, \nrevieweeId: Long, itemId: Long, \nrating: int, comment: String): String
activate RS

note right of RS: Validate rating range
alt rating < 1 || rating > 5
    RS --> OHC: "Rating must be between 1 and 5"
    deactivate RS
    OHC -> DU: showError("Review Failed", error: String)
    activate DU
    DU --> Buyer: <<display>> Error Dialog
    deactivate DU
else rating is valid
    activate RS
    note right of RS: Check if already reviewed
    RS -> RD: findByOrderId(orderId: Long): Review
    activate RD
    RD -> DB: <<SQL>> SELECT * FROM reviews \nWHERE order_id = ?
    activate DB
    DB --> RD: ResultSet
    deactivate DB
    RD --> RS: existingReview: Review
    deactivate RD
    
    alt existingReview != null
        RS --> OHC: "You have already reviewed this order"
        deactivate RS
        OHC -> DU: showError("Review Failed", error: String)
        activate DU
        DU --> Buyer: <<display>> Error Dialog
        deactivate DU
    else existingReview == null
        activate RS
        note right of RS: Create Review object
        RS -> RS: review = new Review()
        RS -> RS: review.setOrderId(orderId)
        RS -> RS: review.setReviewerId(reviewerId)
        RS -> RS: review.setRevieweeId(revieweeId)
        RS -> RS: review.setItemId(itemId)
        RS -> RS: review.setRating(rating)
        RS -> RS: review.setComment(comment)
        RS -> RS: review.setCreatedTime(now())
        
        RS -> RD: save(review: Review): void
        activate RD
        RD -> DB: <<SQL>> INSERT INTO reviews \n(order_id, reviewer_id, reviewee_id, \nitem_id, rating, comment, created_time) \nVALUES (?, ?, ?, ?, ?, ?, ?)
        activate DB
        DB --> RD: rowsAffected: int
        deactivate DB
        RD --> RS: void
        deactivate RD
        
        RS --> OHC: null
        deactivate RS
        
        OHC -> DU: showSuccess("Review submitted successfully!")
        activate DU
        DU --> Buyer: <<display>> Success Dialog
        deactivate DU
        
        OHC -> OHC: loadOrders()
        OHC --> Buyer: <<display>> Updated Order List \n(Review button replaced with "Reviewed" label)
    end
end

deactivate OHC

== Postcondition: Review saved, Seller rating updated ==

@enduml












