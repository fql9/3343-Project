@startuml User_Register_Sequence

title User Registration Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":User" as User
participant ":LoginController" as LC
participant ":UserService" as US
participant ":ValidationUtils" as VU
participant ":UserDaoImpl" as UD
participant ":PasswordUtils" as PU
participant ":DialogUtils" as DU
database ":Database" as DB

autonumber

== Precondition: User clicks Register button ==

User -> LC: showRegisterView()
activate LC
LC --> User: <<display>> Registration Form
deactivate LC

User -> LC: handleRegister()
activate LC

LC -> LC: username = usernameField.getText().trim()
LC -> LC: password = passwordField.getText()
LC -> LC: email = emailField.getText().trim()
LC -> LC: role = UserRole.SELLER

alt username.isEmpty() || password.isEmpty()
    LC -> DU: showWarning("Input Error", \n"Username and password cannot be empty")
    activate DU
    DU --> User: <<display>> Warning Dialog
    deactivate DU
else input is valid
    LC -> US: register(username: String, password: String, \nemail: String, role: UserRole): String
    activate US
    
    note right of US: Validate username format
    US -> VU: isValidUsername(username: String): boolean
    activate VU
    VU -> VU: regex: ^[a-zA-Z0-9_]{3,20}$
    VU --> US: isValid: boolean
    deactivate VU
    
    alt !isValid
        US -> VU: getUsernameValidationMessage(): String
        activate VU
        VU --> US: errorMsg: String
        deactivate VU
        US --> LC: errorMsg
        LC -> DU: showError("Registration Failed", error: String)
        activate DU
        DU --> User: <<display>> Error Dialog
        deactivate DU
    else username format valid
        note right of US: Validate password format
        US -> VU: isValidPassword(password: String): boolean
        activate VU
        VU -> VU: length >= 6
        VU --> US: isValid: boolean
        deactivate VU
        
        alt !isValid
            US -> VU: getPasswordValidationMessage(): String
            activate VU
            VU --> US: errorMsg: String
            deactivate VU
            US --> LC: errorMsg
            LC -> DU: showError("Registration Failed", error: String)
            activate DU
            DU --> User: <<display>> Error Dialog
            deactivate DU
        else password format valid
            note right of US: Validate email format
            US -> VU: isValidEmail(email: String): boolean
            activate VU
            VU -> VU: regex: email pattern
            VU --> US: isValid: boolean
            deactivate VU
            
            alt !isValid
                US --> LC: "Invalid email format"
                LC -> DU: showError("Registration Failed", error: String)
                activate DU
                DU --> User: <<display>> Error Dialog
                deactivate DU
            else email format valid
                note right of US: Check username uniqueness
                US -> UD: findByUsername(username: String): User
                activate UD
                UD -> DB: <<SQL>> SELECT * FROM users \nWHERE username = ?
                activate DB
                DB --> UD: ResultSet
                deactivate DB
                UD --> US: existingUser: User
                deactivate UD
                
                alt existingUser != null
                    US --> LC: "Username already exists"
                    LC -> DU: showError("Registration Failed", error: String)
                    activate DU
                    DU --> User: <<display>> Error Dialog
                    deactivate DU
                else existingUser == null
                    note right of US: Create new User object
                    US -> US: user = new User()
                    US -> US: user.setUsername(username)
                    
                    US -> PU: hashPassword(password: String): String
                    activate PU
                    PU -> PU: MessageDigest.getInstance("SHA-256")
                    PU -> PU: md.digest(password.getBytes())
                    note right of PU: <<crypto>> SHA-256\nBase64.encode(hash)
                    PU --> US: passwordHash: String
                    deactivate PU
                    
                    US -> US: user.setPasswordHash(passwordHash)
                    US -> US: user.setEmail(email)
                    US -> US: user.setRole(role)
                    US -> US: user.setActive(true)
                    US -> US: user.setCreatedTime(now())
                    
                    US -> UD: save(user: User): void
                    activate UD
                    UD -> DB: <<SQL>> INSERT INTO users \n(username, password_hash, email, \nrole, active, created_time) \nVALUES (?, ?, ?, ?, ?, ?)
                    activate DB
                    DB --> UD: rowsAffected: int
                    deactivate DB
                    UD --> US: void
                    deactivate UD
                    
                    US --> LC: null
                    deactivate US
                    
                    LC -> DU: showSuccess("Registration successful! Please login")
                    activate DU
                    DU --> User: <<display>> Success Dialog
                    deactivate DU
                    
                    LC -> LC: showLoginView()
                    LC --> User: <<display>> Login Form
                end
            end
        end
    end
end

deactivate LC

== Postcondition: User is registered and on login page ==

@enduml
