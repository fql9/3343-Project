@startuml Order_Status_Update_Sequence

title Order Status Update Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":Seller" as Seller
actor ":Buyer" as Buyer
participant ":SalesHistoryController" as SHC
participant ":OrderHistoryController" as OHC
participant ":OrderService" as OS
participant ":OrderDaoImpl" as OD
participant ":NotificationService" as NS
participant ":DialogUtils" as DU
database ":Database" as DB

autonumber

== Scenario 1: Seller Ships Order (PAID -> SHIPPED) ==

Seller -> SHC: <<create>> SalesHistoryController(mainLayout: BorderPane)
activate SHC
SHC -> SHC: showSalesHistoryView()

SHC -> SHC: loadSales()
SHC -> OS: getOrdersBySeller(sellerId: Long): List<Order>
activate OS
OS -> OD: findBySellerId(sellerId: Long): List<Order>
activate OD
OD -> DB: <<SQL>> SELECT * FROM orders \nWHERE seller_id = ?
activate DB
DB --> OD: ResultSet
deactivate DB
OD --> OS: orders: List<Order>
deactivate OD
OS --> SHC: orders: List<Order>
deactivate OS

SHC --> Seller: <<display>> Sales Order List
deactivate SHC

Seller -> SHC: handleShipOrder(order: Order)
activate SHC

SHC -> DU: showConfirm("Confirm Shipment", \n"Are you sure you want to mark this order as SHIPPED?")
activate DU
DU --> Seller: <<display>> Confirm Dialog
deactivate DU
Seller --> SHC: true

SHC -> OS: updateOrderStatus(orderId: Long, \nnewStatus: String, operatorId: Long): String
activate OS

OS -> OD: findById(orderId: Long): Order
activate OD
OD -> DB: <<SQL>> SELECT * FROM orders \nWHERE id = ?
activate DB
DB --> OD: ResultSet
deactivate DB
OD --> OS: order: Order
deactivate OD

note right of OS: Validate permission and status transition
OS -> OS: isSeller = order.getSellerId().equals(operatorId)
OS -> OS: oldStatus = order.getStatus()

alt !isSeller && !isBuyer
    OS --> SHC: "Permission denied"
    SHC -> DU: showError("Error", error: String)
    activate DU
    DU --> Seller: <<display>> Error Dialog
    deactivate DU
else if newStatus == "SHIPPED" && !isSeller
    OS --> SHC: "Only seller can ship the order"
    SHC -> DU: showError("Error", error: String)
    activate DU
    DU --> Seller: <<display>> Error Dialog
    deactivate DU
else if newStatus == "SHIPPED" && oldStatus != "PAID"
    OS --> SHC: "Order must be PAID before shipping"
    SHC -> DU: showError("Error", error: String)
    activate DU
    DU --> Seller: <<display>> Error Dialog
    deactivate DU
else validation passed
    OS -> OS: order.setStatus("SHIPPED")
    OS -> OD: update(order: Order): void
    activate OD
    OD -> DB: <<SQL>> UPDATE orders \nSET status = 'SHIPPED' WHERE id = ?
    activate DB
    DB --> OD: rowsAffected: int
    deactivate DB
    OD --> OS: void
    deactivate OD
    
    note right of OS: Notify buyer
    OS -> NS: createNotification(targetUserId: Long, \ntitle: String, content: String): void
    activate NS
    NS -> NS: notification = new Notification()
    NS -> NS: notification.setUserId(targetUserId)
    NS -> NS: notification.setTitle("Order Status Updated")
    NS -> NS: notification.setContent(content)
    NS -> NS: notification.setRead(false)
    NS -> NS: notification.setCreatedTime(now())
    NS -> DB: <<SQL>> INSERT INTO notifications \n(user_id, title, content, is_read, created_time) \nVALUES (?, ?, ?, 0, ?)
    activate DB
    DB --> NS: rowsAffected: int
    deactivate DB
    NS --> OS: void
    deactivate NS
    
    OS --> SHC: null
    deactivate OS
    
    SHC -> DU: showSuccess("Order marked as SHIPPED")
    activate DU
    DU -> DU: showInfo("Success", message: String)
    DU --> Seller: <<display>> Success Dialog
    deactivate DU
    
    SHC -> SHC: loadSales()
    SHC --> Seller: <<display>> Updated Order List
end

deactivate SHC

== Scenario 2: Buyer Confirms Receipt (SHIPPED -> COMPLETED) ==

Buyer -> OHC: <<create>> OrderHistoryController(mainLayout: BorderPane)
activate OHC
OHC -> OHC: showOrderHistoryView()

OHC -> OHC: loadOrders()
OHC -> OS: getOrdersByBuyer(buyerId: Long): List<Order>
activate OS
OS -> OD: findByBuyerId(buyerId: Long): List<Order>
activate OD
OD -> DB: <<SQL>> SELECT * FROM orders \nWHERE buyer_id = ?
activate DB
DB --> OD: ResultSet
deactivate DB
OD --> OS: orders: List<Order>
deactivate OD
OS --> OHC: orders: List<Order>
deactivate OS

OHC --> Buyer: <<display>> Purchase Order List
deactivate OHC

Buyer -> OHC: handleConfirmReceipt(order: Order)
activate OHC

OHC -> DU: showConfirm("Confirm Receipt", \n"Have you received the item? This will complete the order.")
activate DU
DU --> Buyer: <<display>> Confirm Dialog
deactivate DU
Buyer --> OHC: true

OHC -> OS: updateOrderStatus(orderId: Long, \n"COMPLETED", operatorId: Long): String
activate OS

OS -> OD: findById(orderId: Long): Order
activate OD
OD -> DB: <<SQL>> SELECT * FROM orders \nWHERE id = ?
activate DB
DB --> OD: ResultSet
deactivate DB
OD --> OS: order: Order
deactivate OD

OS -> OS: isBuyer = order.getBuyerId().equals(operatorId)
OS -> OS: oldStatus = order.getStatus()

alt oldStatus != "SHIPPED"
    OS --> OHC: "Order must be SHIPPED before completion"
    OHC -> DU: showError("Error", error: String)
    activate DU
    DU --> Buyer: <<display>> Error Dialog
    deactivate DU
else validation passed
    OS -> OS: order.setStatus("COMPLETED")
    OS -> OD: update(order: Order): void
    activate OD
    OD -> DB: <<SQL>> UPDATE orders \nSET status = 'COMPLETED' WHERE id = ?
    activate DB
    DB --> OD: rowsAffected: int
    deactivate DB
    OD --> OS: void
    deactivate OD
    
    note right of OS: Notify seller
    OS -> NS: createNotification(targetUserId: Long, \ntitle: String, content: String): void
    activate NS
    NS -> NS: notification = new Notification()
    NS -> NS: notification.setUserId(targetUserId)
    NS -> NS: notification.setTitle("Order Status Updated")
    NS -> NS: notification.setContent(content)
    NS -> NS: notification.setRead(false)
    NS -> NS: notification.setCreatedTime(now())
    NS -> DB: <<SQL>> INSERT INTO notifications \n(user_id, title, content, is_read, created_time) \nVALUES (?, ?, ?, 0, ?)
    activate DB
    DB --> NS: rowsAffected: int
    deactivate DB
    NS --> OS: void
    deactivate NS
    
    OS --> OHC: null
    deactivate OS
    
    OHC -> DU: showSuccess("Order completed!")
    activate DU
    DU -> DU: showInfo("Success", message: String)
    DU --> Buyer: <<display>> Success Dialog
    deactivate DU
    
    note over OHC: Buyer can now leave a review
    
    OHC -> OHC: loadOrders()
    OHC --> Buyer: <<display>> Updated Order List
end

deactivate OHC

== Scenario 3: Cancel Completed Order (Exception) ==

Buyer -> OHC: onCancelOrderClick(orderId: Long)
activate OHC

OHC -> OS: updateOrderStatus(orderId: Long, \n"CANCELLED", operatorId: Long): String
activate OS

OS -> OD: findById(orderId: Long): Order
activate OD
OD -> DB: <<SQL>> SELECT * FROM orders \nWHERE id = ?
activate DB
DB --> OD: ResultSet
deactivate DB
OD --> OS: order: Order (status = "COMPLETED")
deactivate OD

OS -> OS: oldStatus = order.getStatus()

alt oldStatus == "COMPLETED"
    OS --> OHC: "Cannot cancel completed order"
    deactivate OS
    
    OHC -> DU: showError("Operation Failed", error: String)
    activate DU
    DU --> Buyer: <<display>> Error Dialog
    deactivate DU
end

deactivate OHC

== Postcondition: Order status updated, Notifications sent ==

@enduml
