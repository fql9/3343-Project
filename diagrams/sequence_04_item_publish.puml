@startuml Item_Publish_Sequence

title Item Publish Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":Seller" as Seller
participant ":MyItemsController" as MIC
participant ":ItemService" as IS
participant ":ValidationUtils" as VU
participant ":ItemDaoImpl" as ID
participant ":DialogUtils" as DU
participant ":FileChooser" as FC
database ":Database" as DB

autonumber

== Precondition: Seller is logged in ==

Seller -> MIC: <<create>> MyItemsController(mainLayout: BorderPane)
activate MIC
MIC -> MIC: showMyItemsView()

MIC -> MIC: loadMyItems()
MIC -> IS: getItemsBySeller(sellerId: Long): List<Item>
activate IS
IS -> ID: findBySellerId(sellerId: Long): List<Item>
activate ID
ID -> DB: <<SQL>> SELECT * FROM items \nWHERE seller_id = ?
activate DB
DB --> ID: ResultSet
deactivate DB
ID --> IS: items: List<Item>
deactivate ID
IS --> MIC: items: List<Item>
deactivate IS

MIC --> Seller: <<display>> My Items List
deactivate MIC

Seller -> MIC: showPublishDialog()
activate MIC
MIC -> MIC: dialog = new Dialog<ButtonType>()
MIC -> MIC: dialog.setTitle("Publish Item")
MIC --> Seller: <<display>> Publish Dialog

opt User chooses to upload image
    Seller -> MIC: onChooseFileClick()
    MIC -> FC: showOpenDialog(owner: Window): File
    activate FC
    FC --> Seller: <<display>> File Chooser Dialog
    Seller -> FC: selectFile()
    FC --> MIC: selectedFile: File
    deactivate FC
    MIC -> MIC: imageUrlField.setText(selectedFile.getAbsolutePath())
end

Seller -> MIC: handlePublish(title: String, description: String, \npriceText: String, category: String, imageUrl: String)
activate MIC

MIC -> VU: isNotEmpty(title: String): boolean
activate VU
VU --> MIC: isValid: boolean
deactivate VU

alt !isValid (title is empty)
    MIC -> DU: showWarning("Input Error", "Title cannot be empty")
    activate DU
    DU --> Seller: <<display>> Warning Dialog
    deactivate DU
else title is valid
    MIC -> MIC: price = Double.parseDouble(priceText)
    
    alt NumberFormatException
        MIC -> DU: showError("Input Error", "Price must be a number")
        activate DU
        DU --> Seller: <<display>> Error Dialog
        deactivate DU
    else price parsed successfully
        MIC -> IS: publishItem(sellerId: Long, title: String, \ndescription: String, price: double, \ncategory: String, imageUrl: String): String
        activate IS
        
        note right of IS: Validate title
        IS -> VU: isNotEmpty(title: String): boolean
        activate VU
        VU --> IS: isValid: boolean
        deactivate VU
        
        alt !isValid
            IS --> MIC: "Item title cannot be empty"
            MIC -> DU: showError("Publish Failed", error: String)
            activate DU
            DU --> Seller: <<display>> Error Dialog
            deactivate DU
        else title valid
            note right of IS: Validate price
            IS -> VU: isValidPrice(price: double): boolean
            activate VU
            VU -> VU: price > 0
            VU --> IS: isValid: boolean
            deactivate VU
            
            alt !isValid (price <= 0)
                IS --> MIC: "Item price must be greater than 0"
                MIC -> DU: showError("Publish Failed", error: String)
                activate DU
                DU --> Seller: <<display>> Error Dialog
                deactivate DU
            else price valid
                note right of IS: Create Item object
                IS -> IS: item = new Item()
                IS -> IS: item.setSellerId(sellerId)
                IS -> IS: item.setTitle(title)
                IS -> IS: item.setDescription(description)
                IS -> IS: item.setPrice(price)
                IS -> IS: item.setCategory(category)
                IS -> IS: item.setImageUrl(imageUrl)
                IS -> IS: item.setActive(true)
                IS -> IS: item.setCreatedTime(now())
                
                IS -> ID: save(item: Item): void
                activate ID
                ID -> DB: <<SQL>> INSERT INTO items \n(seller_id, title, description, price, \ncategory, image_url, active, created_time) \nVALUES (?, ?, ?, ?, ?, ?, ?, ?)
                activate DB
                DB --> ID: rowsAffected: int
                deactivate DB
                ID --> IS: void
                deactivate ID
                
                IS --> MIC: null
                deactivate IS
                
                MIC -> DU: showSuccess("Item published successfully!")
                activate DU
                DU -> DU: showInfo("Success", message: String)
                DU --> Seller: <<display>> Success Dialog
                deactivate DU
                
                MIC -> MIC: loadMyItems()
                MIC --> Seller: <<display>> Updated Item List
            end
        end
    end
end

deactivate MIC

== Postcondition: New item is published and visible ==

@enduml
