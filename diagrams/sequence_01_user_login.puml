@startuml User_Login_Sequence

title User Login Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":User" as User
participant ":LoginController" as LC
participant ":UserService" as US
participant ":UserDaoImpl" as UD
participant ":PasswordUtils" as PU
participant ":DialogUtils" as DU
participant ":MainController" as MC
database ":Database" as DB

autonumber

== Precondition: User is on login page ==

User -> LC: handleLogin()
activate LC

LC -> LC: username = usernameField.getText().trim()
LC -> LC: password = passwordField.getText()

alt username.isEmpty() || password.isEmpty()
    LC -> DU: showWarning("Input Error", \n"Please enter username and password")
    activate DU
    DU --> User: <<display>> Warning Dialog
    deactivate DU
    LC --> User: return
else username and password are not empty
    LC -> US: login(username: String, password: String): String
    activate US
    
    US -> UD: findByUsername(username: String): User
    activate UD
    UD -> DB: <<SQL>> SELECT * FROM users \nWHERE username = ?
    activate DB
    DB --> UD: ResultSet
    deactivate DB
    UD -> UD: mapRow(rs: ResultSet): User
    UD --> US: user: User
    deactivate UD
    
    alt user == null
        US --> LC: "User does not exist"
        deactivate US
        LC -> DU: showError("Login Failed", error: String)
        activate DU
        DU --> User: <<display>> Error Dialog
        deactivate DU
    else user != null
        activate US
        US -> US: user.isActive(): boolean
        
        alt !user.isActive()
            US --> LC: "Account has been banned"
            deactivate US
            LC -> DU: showError("Login Failed", error: String)
            activate DU
            DU --> User: <<display>> Error Dialog
            deactivate DU
        else user.isActive() == true
            activate US
            US -> PU: verifyPassword(rawPassword: String, \nhashedPassword: String): boolean
            activate PU
            PU -> PU: hashPassword(rawPassword: String): String
            note right of PU: <<crypto>> SHA-256\nMessageDigest.digest()
            PU -> PU: hashed.equals(hashedPassword)
            PU --> US: isValid: boolean
            deactivate PU
            
            alt isValid == false
                US --> LC: "Incorrect password"
                deactivate US
                LC -> DU: showError("Login Failed", error: String)
                activate DU
                DU --> User: <<display>> Error Dialog
                deactivate DU
            else isValid == true
                US -> US: currentUser = user
                US --> LC: null
                deactivate US
                
                LC -> DU: showSuccess("Login successful!")
                activate DU
                DU -> DU: showInfo("Success", message: String)
                DU --> User: <<display>> Success Dialog
                deactivate DU
                
                LC -> MC: <<create>> MainController(primaryStage: Stage)
                activate MC
                LC -> MC: showMainView()
                MC --> User: <<display>> Main View
                deactivate MC
            end
        end
    end
end

deactivate LC

== Postcondition: User is logged in and on main page ==

@enduml
