@startuml Add_Favorite_Sequence

title Add/Remove Favorite Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":User" as User
participant ":ItemDetailController" as IDC
participant ":FavoriteService" as FS
participant ":ItemDaoImpl" as ID
participant ":FavoriteDaoImpl" as FD
participant ":DialogUtils" as DU
database ":Database" as DB

autonumber

== Precondition: User is viewing item detail page ==

User -> IDC: handleFavorite()
activate IDC

IDC -> IDC: userId = UserService.getCurrentUser().getId()
IDC -> FS: isFavorite(userId: Long, itemId: Long): boolean
activate FS
FS -> FD: exists(userId: Long, itemId: Long): boolean
activate FD
FD -> DB: <<SQL>> SELECT COUNT(*) FROM favorites \nWHERE user_id = ? AND item_id = ?
activate DB
DB --> FD: count: int
deactivate DB
FD --> FS: exists: boolean
deactivate FD
FS --> IDC: isFavorite: boolean
deactivate FS

alt isFavorite == true (Already Favorited - Remove)
    IDC -> FS: removeFavorite(userId: Long, itemId: Long): void
    activate FS
    FS -> FD: deleteByUserAndItem(userId: Long, itemId: Long): void
    activate FD
    FD -> DB: <<SQL>> DELETE FROM favorites \nWHERE user_id = ? AND item_id = ?
    activate DB
    DB --> FD: rowsAffected: int
    deactivate DB
    FD --> FS: void
    deactivate FD
    FS --> IDC: void
    deactivate FS
    
    IDC -> IDC: favoriteButton.setText("Add to Favorites")
    IDC -> IDC: favoriteButton.setStyle(orangeStyle)
    
    IDC -> DU: showSuccess("Removed from favorites")
    activate DU
    DU --> User: <<display>> Success Dialog
    deactivate DU
    
else isFavorite == false (Not Favorited - Add)
    IDC -> FS: addFavorite(userId: Long, itemId: Long): String
    activate FS
    
    note right of FS: Check if item exists
    FS -> ID: findById(itemId: Long): Item
    activate ID
    ID -> DB: <<SQL>> SELECT * FROM items \nWHERE id = ?
    activate DB
    DB --> ID: ResultSet
    deactivate DB
    ID --> FS: item: Item
    deactivate ID
    
    alt item == null
        FS --> IDC: "Item does not exist"
        deactivate FS
        IDC -> DU: showError("Favorite Failed", error: String)
        activate DU
        DU --> User: <<display>> Error Dialog
        deactivate DU
    else item exists
        activate FS
        note right of FS: Check if already favorited
        FS -> FD: exists(userId: Long, itemId: Long): boolean
        activate FD
        FD -> DB: <<SQL>> SELECT COUNT(*) FROM favorites \nWHERE user_id = ? AND item_id = ?
        activate DB
        DB --> FD: count: int
        deactivate DB
        FD --> FS: exists: boolean
        deactivate FD
        
        alt exists == true
            FS --> IDC: "Already favorited this item"
            deactivate FS
            IDC -> DU: showError("Favorite Failed", error: String)
            activate DU
            DU --> User: <<display>> Error Dialog
            deactivate DU
        else exists == false
            activate FS
            note right of FS: Create Favorite object
            FS -> FS: favorite = new Favorite()
            FS -> FS: favorite.setUserId(userId)
            FS -> FS: favorite.setItemId(itemId)
            FS -> FS: favorite.setCreatedTime(now())
            
            FS -> FD: save(favorite: Favorite): void
            activate FD
            FD -> DB: <<SQL>> INSERT INTO favorites \n(user_id, item_id, created_time) \nVALUES (?, ?, ?)
            activate DB
            DB --> FD: rowsAffected: int
            deactivate DB
            FD --> FS: void
            deactivate FD
            
            FS --> IDC: null
            deactivate FS
            
            IDC -> IDC: favoriteButton.setText("Favorited")
            IDC -> IDC: favoriteButton.setStyle(grayStyle)
            
            IDC -> DU: showSuccess("Added to favorites")
            activate DU
            DU --> User: <<display>> Success Dialog
            deactivate DU
        end
    end
end

deactivate IDC

== Postcondition: Favorite status toggled ==

@enduml












