@startuml Pattern_Layered_Architecture

title Design Pattern - Layered Architecture Pattern

' ========== Classic Blue Style (Matching Sequence Diagrams) ==========
skinparam backgroundColor White
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam component {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
    ArrowColor #282828
}

skinparam package {
    BackgroundColor White
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

skinparam rectangle {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

package "Presentation Layer" {
    rectangle "LoginController" as LC
    rectangle "MainController" as MC
    rectangle "BoardController" as BC
    rectangle "ItemDetailController" as IDC
    rectangle "CheckoutController" as CC
    rectangle "MyItemsController" as MIC
    rectangle "OrderHistoryController" as OHC
    rectangle "SalesHistoryController" as SHC
    rectangle "FavoritesController" as FC
    rectangle "MessageController" as MsgC
    rectangle "NotificationController" as NC
    rectangle "UserProfileController" as UPC
    rectangle "UserManagementController" as UMC
}

package "Service Layer" {
    rectangle "UserService" as US
    rectangle "ItemService" as IS
    rectangle "OrderService" as OS
    rectangle "MessageService" as MS
    rectangle "FavoriteService" as FS
    rectangle "ReviewService" as RS
    rectangle "NotificationService" as NS
}

package "Data Access Layer (DAO)" {
    rectangle "UserDaoImpl" as UDI
    rectangle "ItemDaoImpl" as IDI
    rectangle "OrderDaoImpl" as ODI
    rectangle "MessageDaoImpl" as MDI
    rectangle "FavoriteDaoImpl" as FDI
    rectangle "ReviewDaoImpl" as RDI
    rectangle "NotificationDaoImpl" as NDI
}

package "Model Layer" {
    rectangle "User" as U
    rectangle "Item" as I
    rectangle "Order" as O
    rectangle "Message" as Msg
    rectangle "Favorite" as F
    rectangle "Review" as R
    rectangle "Notification" as N
    rectangle "UserRole" as UR
}

database "SQLite Database" as DB

' Layer connections (simplified)
LC --> US
MC --> US
BC --> IS
IDC --> IS
CC --> OS
MIC --> IS
OHC --> OS
SHC --> OS
FC --> FS
MsgC --> MS
NC --> NS
UPC --> US
UMC --> US

US --> UDI
IS --> IDI
OS --> ODI
MS --> MDI
FS --> FDI
RS --> RDI
NS --> NDI

UDI --> U
IDI --> I
ODI --> O
MDI --> Msg
FDI --> F
RDI --> R
NDI --> N

UDI --> DB
IDI --> DB
ODI --> DB
MDI --> DB
FDI --> DB
RDI --> DB
NDI --> DB

note right of LC
  **Presentation Layer**
  - Handle user input
  - Display UI (JavaFX)
  - Validate user actions
  - Navigate between views
end note

note right of US
  **Service Layer**
  - Business logic
  - Validation rules
  - Coordinate DAOs
  - Transaction management
end note

note right of UDI
  **Data Access Layer**
  - CRUD operations
  - SQL queries
  - ResultSet mapping
  - Connection handling
end note

note right of U
  **Model Layer**
  - Entity classes
  - Data transfer objects
  - Enumerations
  - Value objects
end note

@enduml

