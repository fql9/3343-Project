@startuml Complete_Class_Diagram_Simplified

title Second-Hand Trading Platform - Complete Class Diagram (Simplified)

' ========== Classic Blue Style (Matching Sequence Diagrams) ==========
skinparam backgroundColor White
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam class {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
    AttributeFontName Arial
    AttributeFontColor Black
    ArrowColor #282828
}

skinparam interface {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam enum {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam package {
    BackgroundColor White
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

skinparam classAttributeIconSize 0
skinparam linetype ortho

' ========== Model Layer ==========
package "model" {
    enum UserRole <<enumeration>> {
        BUYER
        SELLER
        ADMIN
    }
    
    class User {
        - id : Long
        - username : String
        - passwordHash : String
        - email : String
        - role : UserRole
        - active : boolean
        - avatarUrl : String
        - bio : String
        - createdTime : String
    }
    
    class Item {
        - id : Long
        - sellerId : Long
        - title : String
        - description : String
        - price : double
        - category : String
        - imageUrl : String
        - active : boolean
        - createdTime : String
    }
    
    class Order {
        - id : Long
        - orderNo : String
        - buyerId : Long
        - sellerId : Long
        - itemId : Long
        - amount : double
        - status : String
        - shippingAddress : String
        - createdTime : String
    }
    
    class Message {
        - id : Long
        - fromUserId : Long
        - toUserId : Long
        - content : String
        - createdTime : String
        - read : boolean
    }
    
    class Notification {
        - id : Long
        - userId : Long
        - title : String
        - content : String
        - isRead : boolean
        - createdTime : String
    }
    
    class Review {
        - id : Long
        - orderId : Long
        - reviewerId : Long
        - revieweeId : Long
        - itemId : Long
        - rating : int
        - comment : String
        - createdTime : String
    }
    
    class Favorite {
        - id : Long
        - userId : Long
        - itemId : Long
        - createdTime : String
    }
    
    User --> UserRole
}

' ========== DAO Layer ==========
package "dao" {
    interface UserDao <<interface>>
    interface ItemDao <<interface>>
    interface OrderDao <<interface>>
    interface MessageDao <<interface>>
    interface NotificationDao <<interface>>
    interface ReviewDao <<interface>>
    interface FavoriteDao <<interface>>
}

package "dao.impl" {
    class UserDaoImpl
    class ItemDaoImpl
    class OrderDaoImpl
    class MessageDaoImpl
    class NotificationDaoImpl
    class ReviewDaoImpl
    class FavoriteDaoImpl
    
    UserDaoImpl ..|> UserDao
    ItemDaoImpl ..|> ItemDao
    OrderDaoImpl ..|> OrderDao
    MessageDaoImpl ..|> MessageDao
    NotificationDaoImpl ..|> NotificationDao
    ReviewDaoImpl ..|> ReviewDao
    FavoriteDaoImpl ..|> FavoriteDao
}

' ========== Service Layer ==========
package "service" {
    class UserService {
        - userDao : UserDao
        - {static} currentUser : User
    }
    class ItemService {
        - itemDao : ItemDao
    }
    class OrderService {
        - orderDao : OrderDao
        - itemDao : ItemDao
        - notificationService : NotificationService
    }
    class MessageService {
        - messageDao : MessageDao
    }
    class NotificationService {
        - notificationDao : NotificationDao
    }
    class ReviewService {
        - reviewDao : ReviewDao
    }
    class FavoriteService {
        - favoriteDao : FavoriteDao
        - itemDao : ItemDao
    }
    
    UserService --> UserDao
    ItemService --> ItemDao
    OrderService --> OrderDao
    OrderService --> ItemDao
    OrderService --> NotificationService
    MessageService --> MessageDao
    NotificationService --> NotificationDao
    ReviewService --> ReviewDao
    FavoriteService --> FavoriteDao
    FavoriteService --> ItemDao
}

' ========== Config & Util ==========
package "config" {
    class DatabaseConfig {
        - {static} DB_URL : String
    }
}

package "util" {
    class PasswordUtils
    class ValidationUtils
}

package "view.util" {
    class DialogUtils
}

' ========== Controller Layer ==========
package "view.controller" {
    class MainApp
    class LoginController
    class MainController
    class BoardController
    class ItemDetailController
    class CheckoutController
    class MyItemsController
    class OrderHistoryController
    class SalesHistoryController
    class FavoritesController
    class MessageController
    class NotificationController
    class UserProfileController
    class UserManagementController
    
    MainApp --> LoginController
    LoginController --> MainController
    
    MainController --> BoardController
    MainController --> MyItemsController
    MainController --> OrderHistoryController
    MainController --> SalesHistoryController
    MainController --> FavoritesController
    MainController --> MessageController
    MainController --> NotificationController
    MainController --> UserProfileController
    MainController --> UserManagementController
    
    BoardController --> ItemDetailController
    ItemDetailController --> CheckoutController
}

' ========== Cross-Layer Dependencies ==========
' DAO to Config
UserDaoImpl ..> DatabaseConfig
ItemDaoImpl ..> DatabaseConfig
OrderDaoImpl ..> DatabaseConfig
MessageDaoImpl ..> DatabaseConfig
NotificationDaoImpl ..> DatabaseConfig
ReviewDaoImpl ..> DatabaseConfig
FavoriteDaoImpl ..> DatabaseConfig

' Service to Util
UserService ..> PasswordUtils
UserService ..> ValidationUtils
ItemService ..> ValidationUtils

' Controller to Service
LoginController --> UserService
MainController --> UserService
MainController --> MessageService
MainController --> NotificationService
BoardController --> ItemService
ItemDetailController --> FavoriteService
ItemDetailController --> UserService
ItemDetailController --> ReviewService
CheckoutController --> OrderService
MyItemsController --> ItemService
OrderHistoryController --> OrderService
OrderHistoryController --> ItemService
OrderHistoryController --> ReviewService
SalesHistoryController --> OrderService
SalesHistoryController --> ItemService
SalesHistoryController --> UserService
FavoritesController --> FavoriteService
FavoritesController --> ItemService
MessageController --> MessageService
MessageController --> UserService
NotificationController --> NotificationService
UserProfileController --> UserService
UserManagementController --> UserService

@enduml
