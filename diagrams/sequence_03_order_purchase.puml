@startuml Order_Purchase_Sequence

title Order Purchase Sequence Diagram

' ========== Classic Blue Style ==========
skinparam backgroundColor White
skinparam sequenceMessageAlign center
skinparam responseMessageBelowArrow true
skinparam maxMessageSize 200
skinparam BoxPadding 20
skinparam roundcorner 0
skinparam defaultFontName Arial
skinparam defaultFontSize 11

skinparam participant {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontStyle bold
    FontName Arial
}

skinparam actor {
    BackgroundColor White
    BorderColor #282828
    FontName Arial
}

skinparam database {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontColor Black
    FontName Arial
}

skinparam sequence {
    ArrowColor #282828
    ArrowFontColor #282828
    ArrowFontName Arial
    LifeLineBorderColor #282828
    LifeLineBackgroundColor #58d2f9
    GroupBackgroundColor White
    GroupBorderColor #282828
    GroupFontName Arial
    DividerBackgroundColor White
    DividerBorderColor #282828
    DividerFontName Arial
}

skinparam note {
    BackgroundColor #58d2f9
    BorderColor #282828
    FontName Arial
}

actor ":Buyer" as Buyer
actor ":Seller" as Seller
participant ":BoardController" as BC
participant ":ItemDetailController" as IDC
participant ":CheckoutController" as CC
participant ":OrderService" as OS
participant ":ItemDaoImpl" as ID
participant ":OrderDaoImpl" as OD
participant ":NotificationService" as NS
participant ":DialogUtils" as DU
database ":Database" as DB

autonumber

== Precondition: Buyer is logged in ==

Buyer -> BC: showBoardView()
activate BC
BC --> Buyer: <<display>> Item List
deactivate BC

Buyer -> BC: showItemDetail(item: Item)
activate BC
BC -> IDC: <<create>> ItemDetailController(mainLayout: BorderPane, item: Item)
activate IDC
BC -> IDC: showItemDetailView()
IDC --> Buyer: <<display>> Item Detail Page
deactivate BC

Buyer -> IDC: onBuyNowClick()
IDC -> CC: <<create>> CheckoutController(mainLayout: BorderPane, item: Item)
activate CC
IDC -> CC: showCheckoutView()
CC --> Buyer: <<display>> Checkout Page
deactivate IDC

Buyer -> CC: handlePayment(address: String)
activate CC

alt address == null || address.trim().isEmpty()
    CC -> DU: showWarning("Input Error", \n"Please enter shipping address")
    activate DU
    DU --> Buyer: <<display>> Warning Dialog
    deactivate DU
else address is valid
    CC -> DU: showConfirm("Confirm Payment", \n"Pay ¥" + item.getPrice() + " for this item?")
    activate DU
    DU --> Buyer: <<display>> Confirm Dialog
    deactivate DU
    
    alt user clicks Cancel
        Buyer --> CC: false
    else user clicks Confirm
        Buyer --> CC: true
        
        CC -> OS: createOrder(buyerId: Long, itemId: Long, \nshippingAddress: String): String
        activate OS
        
        note right of OS: Retrieve item from database
        OS -> ID: findById(itemId: Long): Item
        activate ID
        ID -> DB: <<SQL>> SELECT * FROM items \nWHERE id = ?
        activate DB
        DB --> ID: ResultSet
        deactivate DB
        ID --> OS: item: Item
        deactivate ID
        
        alt item == null
            OS --> CC: "Item not found"
            CC -> DU: showError("Order Failed", error: String)
            activate DU
            DU --> Buyer: <<display>> Error Dialog
            deactivate DU
        else if !item.isActive()
            OS --> CC: "Item is no longer available"
            CC -> DU: showError("Order Failed", error: String)
            activate DU
            DU --> Buyer: <<display>> Error Dialog
            deactivate DU
        else if item.getSellerId().equals(buyerId)
            OS --> CC: "Cannot buy your own item"
            CC -> DU: showError("Order Failed", error: String)
            activate DU
            DU --> Buyer: <<display>> Error Dialog
            deactivate DU
        else if !ValidationUtils.isNotEmpty(shippingAddress)
            OS --> CC: "Shipping address cannot be empty"
            CC -> DU: showError("Order Failed", error: String)
            activate DU
            DU --> Buyer: <<display>> Error Dialog
            deactivate DU
        else validation passed
            note right of OS: Create Order object
            OS -> OS: order = new Order()
            OS -> OS: order.setOrderNo(UUID.randomUUID().toString())
            OS -> OS: order.setBuyerId(buyerId)
            OS -> OS: order.setSellerId(item.getSellerId())
            OS -> OS: order.setItemId(itemId)
            OS -> OS: order.setAmount(item.getPrice())
            OS -> OS: order.setStatus("PAID")
            OS -> OS: order.setShippingAddress(shippingAddress)
            OS -> OS: order.setCreatedTime(now())
            
            OS -> OD: save(order: Order): void
            activate OD
            OD -> DB: <<SQL>> INSERT INTO orders \n(order_no, buyer_id, seller_id, item_id, \namount, status, shipping_address, created_time) \nVALUES (?, ?, ?, ?, ?, ?, ?, ?)
            activate DB
            DB --> OD: rowsAffected: int
            deactivate DB
            OD --> OS: void
            deactivate OD
            
            note right of OS: Mark item as sold
            OS -> OS: item.setActive(false)
            OS -> ID: update(item: Item): void
            activate ID
            ID -> DB: <<SQL>> UPDATE items \nSET active = 0 WHERE id = ?
            activate DB
            DB --> ID: rowsAffected: int
            deactivate DB
            ID --> OS: void
            deactivate ID
            
            note right of OS: Notify seller
            OS -> NS: createNotification(userId: Long, \ntitle: String, content: String): void
            activate NS
            NS -> NS: notification = new Notification()
            NS -> NS: notification.setUserId(userId)
            NS -> NS: notification.setTitle(title)
            NS -> NS: notification.setContent(content)
            NS -> NS: notification.setRead(false)
            NS -> NS: notification.setCreatedTime(now())
            NS -> DB: <<SQL>> INSERT INTO notifications \n(user_id, title, content, is_read, created_time) \nVALUES (?, ?, ?, 0, ?)
            activate DB
            DB --> NS: rowsAffected: int
            deactivate DB
            NS --> OS: void
            deactivate NS
            
            OS --> CC: null
            deactivate OS
            
            CC -> DU: showSuccess("Payment Successful! Order created.")
            activate DU
            DU -> DU: showInfo("Success", message: String)
            DU --> Buyer: <<display>> Success Dialog
            deactivate DU
            
            CC -> BC: <<create>> BoardController(mainLayout: BorderPane)
            activate BC
            CC -> BC: showBoardView()
            BC --> Buyer: <<display>> Item List
            deactivate BC
        end
    end
end

deactivate CC

== Postcondition: Order created, Item marked as sold ==

@enduml
